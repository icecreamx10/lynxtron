{
  "name": "@lynx-js/lynxtron-mobile",
  "version": "0.0.0-alpha",
  "description": "NativeScript host plugin for running Lynx applications on mobile",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context-bridge": {
      "types": "./dist/context-bridge.d.ts",
      "default": "./dist/context-bridge.js"
    },
    "./worker-runtime": {
      "types": "./dist/worker-runtime.d.ts",
      "default": "./dist/worker-runtime.js"
    },
    "./native-adapter": {
      "types": "./dist/native-adapter.d.ts",
      "default": "./dist/native-adapter.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "nativescript": {},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "npm run build && node demo/run-mvp.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "peerDependencies": {
    "@nativescript/core": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@nativescript/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  },
  "license": "Apache-2.0"
}
